generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url      = "postgresql://niunmango_user:Niunmango1Psw!@db:5432/niunmango_db"
}

// User model for Google authentication
model User {
id            String     @id @default(uuid())
googleId      String?    @unique
email         String     @unique
name          String?
entries       Entry[]
categories    Category[]
budgets       Budget[]
}

// Categories for expenses/income
model Category {
id            String       @id @default(uuid())
name          String
userId        String
user          User         @relation(fields: [userId], references: [id])
entries       Entry[]
budgetItems   BudgetItem[]

@@unique([name, userId])
}

// Model for financial entries (expenses, income, savings)
model Entry {
id            String     @id @default(uuid())
type          EntryType
amount        Decimal
date          DateTime   @default(now())
description   String
userId        String
user          User       @relation(fields: [userId], references: [id])
categoryId    String
category      Category   @relation(fields: [categoryId], references: [id])
}

// Enum for entry types
enum EntryType {
EXPENSE
INCOME
SAVINGS
}

// Model for a budget for a specific period
model Budget {
id            String       @id @default(uuid())
name          String
startDate     DateTime
endDate       DateTime
userId        String
user          User         @relation(fields: [userId], references: [id])
budgetItems   BudgetItem[]
}

// Model for a budget item (budgeted amount for a specific category)
model BudgetItem {
id              String   @id @default(uuid())
budgetId        String
budget          Budget   @relation(fields: [budgetId], references: [id])
categoryId      String
category        Category @relation(fields: [categoryId], references: [id])
budgetedAmount  Decimal

@@unique([budgetId, categoryId])
}